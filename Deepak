  function deleteStudy(index) {  
    if (confirm('Are you sure you want to delete this study record?')) {  
      studyData.splice(index, 1);  
      localStorage.setItem('study_data_v2', JSON.stringify(studyData));  
      renderAll();  
    }  
  }  
  
  document.getElementById('testForm').addEventListener('submit', (e) => {  
    e.preventDefault();  
    const date = document.getElementById('testDate').value;  
    const subject = document.getElementById('testSubject').value.trim();  
    const status = document.getElementById('testStatus').value;  
    const marks = status === 'Attended' ? parseFloat(document.getElementById('testMarks').value || 0) : 0;  
  
    if (editTestId !== null) {  
      testData[editTestId] = { date, subject, status, marks };  
      cancelTestEdit();  
